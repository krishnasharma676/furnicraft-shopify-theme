{{ 'section-value-props.css' | asset_url | stylesheet_tag }}

<div class="value-props-bar section-{{ section.id }}-padding">
  <div class="value-props-bar__container">
    {%- if section.blocks.size > 0 -%}
      <div class="value-props-bar__grid">
        {%- for block in section.blocks -%}
          <div class="value-prop-item" {{ block.shopify_attributes }}>
            <div class="value-prop-item__icon">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="M9 12l2 2 4-4"/>
                  </svg>
                {%- when 'craft' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                  </svg>
                {%- when 'custom' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                  </svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
              {%- endcase -%}
            </div>
            <div class="value-prop-item__text">
              {%- if block.settings.title != blank -%}
                <h3 class="value-prop-item__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p class="value-prop-item__subtext">{{ block.settings.subtext | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Value Props Bar",
  "tag": "section",
  "class": "section-value-props-bar",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield (Quality)" },
            { "value": "craft", "label": "Craftsmanship (Tools)" },
            { "value": "custom", "label": "Customisation (Gear/Sliders)" },
            { "value": "truck", "label": "Delivery Truck" }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Premium Quality"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtitle",
          "default": "Finest materials"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value Props Bar",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Premium Quality",
            "subtext": "Finest materials"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "craft",
            "title": "Expert Craftsmanship",
            "subtext": "Built to last"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "custom",
            "title": "Customisation",
            "subtext": "Made for you"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "truck",
            "title": "Pan-India Delivery",
            "subtext": "Fast & reliable"
          }
        }
      ]
    }
  ]
}
{% endschema %}
