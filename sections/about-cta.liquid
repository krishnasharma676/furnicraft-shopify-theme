{{ 'section-about-cta.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .about-cta-{{ section.id }} {
    --cta-bg: {{ section.settings.background_color | default: '#824E2B' }};
    --cta-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    background-color: var(--cta-bg);
    color: var(--cta-text);
  }
{%- endstyle -%}

<section class="about-cta about-cta-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="about-container">
    <div class="about-cta__box about-reveal">
      
      {%- if section.settings.badge_text != blank -%}
        <div class="about-cta__badge">
          {{ section.settings.badge_text | escape }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="about-cta__title">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="about-cta__subtitle">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      <div class="about-cta__actions">
        {%- if section.settings.button_1_label != blank -%}
          <a href="{{ section.settings.button_1_url | default: '/collections/all' }}" class="about-cta-btn about-cta-btn--light">
            <span>{{ section.settings.button_1_label | escape }}</span>
            <svg class="about-btn__arrow" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.button_2_label != blank -%}
          <a href="{{ section.settings.button_2_url | default: '/pages/contact' }}" class="about-cta-btn about-cta-btn--outline">
            <span>{{ section.settings.button_2_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.show_perks -%}
        <div class="about-cta__perks">
          <div class="cta-perk">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="M12 5l7 7-7 7"/></svg>
            <span>Pan-India Safe Delivery</span>
          </div>
          <div class="cta-perk">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>10-Year Structural Guarantee</span>
          </div>
          <div class="cta-perk">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <span>Dedicated Interior Advisory</span>
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Call To Action",
  "tag": "section",
  "class": "section-about-cta",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "TRANSFORM YOUR SANCTUARY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready To Bring Heirloom Luxury Into Your Home?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our curated living, bedroom, and dining collections, or reach out to our design consultants for bespoke interior projects."
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "EXPLORE ALL COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "REQUEST A CUSTOM QUOTE"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_perks",
      "label": "Show Perks Bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#824E2B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "About Call To Action"
    }
  ]
}
{% endschema %}
