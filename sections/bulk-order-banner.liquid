{{ 'section-bulk-order-banner.css' | asset_url | stylesheet_tag }}

<div class="bulk-order-banner section-{{ section.id }}-padding">
  <div class="bulk-order-banner__wrapper page-width-normal">
    <div class="bulk-order-banner__container">
      <div class="bulk-order-banner__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="bulk-order-banner__heading">
            {{ section.settings.heading | escape | newline_to_br }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="bulk-order-banner__subtext">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          {%- assign target_link = section.settings.button_link -%}
          {%- if target_link == blank -%}
            {%- assign target_link = '/pages/contact' -%}
          {%- endif -%}
          <a href="{{ target_link }}" class="bulk-order-banner__btn">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>

      <div class="bulk-order-banner__media">
        {%- if section.settings.banner_image != blank -%}
          {{
            section.settings.banner_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 55vw, 100vw',
              widths: '400, 600, 800, 1000, 1200',
              class: 'bulk-order-banner__image',
              alt: section.settings.heading
          }}
        {%- else -%}
          <img src="{{ 'bulk-order-lifestyle.png' | asset_url }}" loading="lazy" class="bulk-order-banner__image" alt="Furnishing a large space" width="1000" height="600">
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bulk Order Banner",
  "tag": "section",
  "class": "section-bulk-order-banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Furnishing a large space?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get special pricing for bulk orders. Perfect for hotels, offices & projects."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "REQUEST A BULK QUOTE"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner Image"
    }
  ],
  "presets": [
    {
      "name": "Bulk Order Banner",
      "settings": {
        "heading": "Furnishing a large space?",
        "subheading": "Get special pricing for bulk orders. Perfect for hotels, offices & projects.",
        "button_label": "REQUEST A BULK QUOTE"
      }
    }
  ]
}
{% endschema %}
