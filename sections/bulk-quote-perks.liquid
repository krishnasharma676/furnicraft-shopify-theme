{{ 'section-bulk-quote-perks.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .bulk-perks-{{ section.id }} {
    --perks-bg: {{ section.settings.background_color | default: '#2C221E' }};
    --perks-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --perks-accent: {{ section.settings.accent_color | default: '#D4A373' }};
    background-color: var(--perks-bg);
    color: var(--perks-text);
  }
{%- endstyle -%}

<section class="bulk-perks bulk-perks-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="about-container">
    
    <div class="bulk-perks__header">
      {%- if section.settings.badge_text != blank -%}
        <span class="bulk-perks__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="bulk-perks__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="bulk-perks__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="bulk-perks__grid">
      {%- for block in section.blocks -%}
        <div class="bulk-perk-card" {{ block.shopify_attributes }}>
          <div class="bulk-perk-card__icon">
            {%- case block.settings.icon -%}
              {%- when 'discount' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
              {%- when 'cad' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              {%- when 'manager' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            {%- endcase -%}
          </div>

          <h3 class="bulk-perk-card__title">{{ block.settings.title | escape }}</h3>
          <p class="bulk-perk-card__desc">{{ block.settings.description | escape }}</p>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "B2B Wholesale Perks",
  "tag": "section",
  "class": "section-bulk-perks",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "THE FURNICRAFT B2B ADVANTAGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Commercial Clients Choose FurniCraft"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From boutique design agencies to multi-story hospitality chains, we deliver exceptional craftsmanship on time and within budget."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#2C221E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4A373"
    }
  ],
  "blocks": [
    {
      "type": "perk_item",
      "name": "Perk Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "discount", "label": "Discount / Volume" },
            { "value": "cad", "label": "CAD / Custom Design" },
            { "value": "manager", "label": "Dedicated Manager" },
            { "value": "truck", "label": "Logistics / Delivery" }
          ],
          "default": "discount"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tiered Volume Discounts"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Save 15% to 40% on commercial scale orders with direct factory margins and transparent GST invoicing."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "B2B Wholesale Perks",
      "blocks": [
        {
          "type": "perk_item",
          "settings": {
            "icon": "discount",
            "title": "Tiered Volume Discounts",
            "description": "Save 15% to 40% on bulk volume orders with transparent factory-direct pricing and GST input credit."
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "icon": "cad",
            "title": "Custom CAD & Bespoke Sizing",
            "description": "We fabricate custom dimensions, wood finishes, and upholstery tailored to your exact architectural blueprints."
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "icon": "manager",
            "title": "Dedicated Account Manager",
            "description": "Direct single point of contact for live factory updates, wood sample swatches, and milestone tracking."
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "icon": "truck",
            "title": "Pan-India White-Glove Logistics",
            "description": "Insured heavy freight dispatch with on-site unboxing, room-of-choice placement, and debris removal."
          }
        }
      ]
    }
  ]
}
{% endschema %}
