{{ 'section-bulk-quote-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .bulk-hero-{{ section.id }} {
    --b2b-bg: {{ section.settings.background_color | default: '#FAF8F5' }};
    --b2b-text: {{ section.settings.text_color | default: '#1C1917' }};
    --b2b-accent: {{ section.settings.accent_color | default: '#824E2B' }};
    background-color: var(--b2b-bg);
    color: var(--b2b-text);
  }
{%- endstyle -%}

<section class="bulk-hero bulk-hero-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="about-container">
    <div class="bulk-hero__content">
      
      {%- if section.settings.badge_text != blank -%}
        <div class="bulk-hero__badge">
          <span class="bulk-hero__badge-dot"></span>
          <span class="bulk-hero__badge-text">{{ section.settings.badge_text | escape }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="bulk-hero__title">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="bulk-hero__subtitle">
          {{ section.settings.subheading | escape }}
        </p>
      {%- endif -%}

      <!-- Tiered Discount Highlights -->
      <div class="bulk-hero__tiers">
        <div class="bulk-tier-pill">
          <span class="bulk-tier-pill__label">10 - 49 Units</span>
          <span class="bulk-tier-pill__discount">Save up to 15%</span>
        </div>
        <div class="bulk-tier-pill bulk-tier-pill--featured">
          <span class="bulk-tier-pill__tag">MOST POPULAR</span>
          <span class="bulk-tier-pill__label">50 - 99 Units</span>
          <span class="bulk-tier-pill__discount">Save up to 25%</span>
        </div>
        <div class="bulk-tier-pill">
          <span class="bulk-tier-pill__label">100+ Units</span>
          <span class="bulk-tier-pill__discount">Save up to 40%</span>
        </div>
      </div>

      <!-- Key Assurance Strip -->
      <div class="bulk-hero__assurances">
        <div class="assurance-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          <span>GST Input Tax Credit</span>
        </div>
        <div class="assurance-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Commercial 10-Yr Warranty</span>
        </div>
        <div class="assurance-chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Pan-India Site Delivery</span>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bulk Quote Hero",
  "tag": "section",
  "class": "section-bulk-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "WHOLESALE & ARCHITECTURAL INQUIRIES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Partner With FurniCraft For Bulk & Commercial Furniture"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We collaborate with interior architects, hotel developers, corporate spaces, and retailers to supply handcrafted heirloom furniture with direct factory pricing and white-glove site delivery."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1C1917"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#824E2B"
    }
  ],
  "presets": [
    {
      "name": "Bulk Quote Hero"
    }
  ]
}
{% endschema %}
