{{ 'section-shop-by-category.css' | asset_url | stylesheet_tag }}

<div class="shop-by-category section-{{ section.id }}-padding">
  <div class="shop-by-category__wrapper page-width-normal">
    {%- if section.settings.heading != blank -%}
      <h2 class="shop-by-category__heading text-center">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- assign assigned_count = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.collection != blank -%}
        {%- assign assigned_count = assigned_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

    {%- assign show_all = section.settings.show_all_collections -%}
    {%- if show_all == nil -%}
      {%- assign show_all = true -%}
    {%- endif -%}

    <div class="shop-by-category__slider-wrapper">
      <button type="button" class="shop-by-category__arrow shop-by-category__arrow--prev" aria-label="Previous categories" style="display: none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="shop-by-category__grid" id="ShopByCategoryGrid-{{ section.id }}">
        {%- if show_all or assigned_count == 0 -%}
          {%- for col in collections -%}
            {%- unless col.handle == 'frontpage' or col.handle == 'all' -%}
              {%- assign category_title = col.title -%}
              {%- assign category_url = col.url -%}
              {%- assign category_image = col.image -%}
              {%- if category_image == blank -%}
                {%- assign category_image = col.featured_image -%}
              {%- endif -%}
              {%- if category_image == blank -%}
                {%- assign category_image = col.products.first.featured_image -%}
              {%- endif -%}

              <div class="shop-by-category__item">
                <a href="{{ category_url }}" class="category-card">
                  <div class="category-card__image-wrapper">
                    {%- if category_image != blank -%}
                      {{
                        category_image
                        | image_url: width: 400
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 1025px) 220px, (min-width: 768px) 180px, 40vw',
                          widths: '180, 240, 320, 400',
                          class: 'category-card__image',
                          alt: category_title
                      }}
                    {%- else -%}
                      <div class="category-card__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg category-card__image' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <span class="category-card__title">{{ category_title | escape }}</span>
                </a>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            {%- assign collection = block.settings.collection -%}
            {%- if collection != blank -%}
              {%- assign category_title = block.settings.title -%}
              {%- if category_title == blank -%}
                {%- assign category_title = collection.title -%}
              {%- endif -%}
              {%- assign category_url = collection.url -%}
              {%- assign category_image = block.settings.custom_image -%}
              {%- if category_image == blank -%}
                {%- assign category_image = collection.image -%}
              {%- endif -%}
              {%- if category_image == blank -%}
                {%- assign category_image = collection.featured_image -%}
              {%- endif -%}
              {%- if category_image == blank -%}
                {%- assign category_image = collection.products.first.featured_image -%}
              {%- endif -%}

              <div class="shop-by-category__item" {{ block.shopify_attributes }}>
                <a href="{{ category_url }}" class="category-card">
                  <div class="category-card__image-wrapper">
                    {%- if category_image != blank -%}
                      {{
                        category_image
                        | image_url: width: 400
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 1025px) 220px, (min-width: 768px) 180px, 40vw',
                          widths: '180, 240, 320, 400',
                          class: 'category-card__image',
                          alt: category_title
                      }}
                    {%- else -%}
                      <div class="category-card__placeholder">
                        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg category-card__image' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <span class="category-card__title">{{ category_title | escape }}</span>
                </a>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>

      <button type="button" class="shop-by-category__arrow shop-by-category__arrow--next" aria-label="Next categories" style="display: none;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <script>
      (function() {
        function initCategorySliders() {
          document.querySelectorAll('.shop-by-category__slider-wrapper').forEach(function(wrapper) {
            var grid = wrapper.querySelector('.shop-by-category__grid');
            var prevBtn = wrapper.querySelector('.shop-by-category__arrow--prev');
            var nextBtn = wrapper.querySelector('.shop-by-category__arrow--next');
            if (!grid) return;

            function updateArrows() {
              if (!prevBtn || !nextBtn) return;
              var maxScroll = grid.scrollWidth - grid.clientWidth;
              var hasOverflow = maxScroll > 6;

              if (!hasOverflow) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
                grid.classList.remove('has-overflow');
              } else {
                prevBtn.style.display = '';
                nextBtn.style.display = '';
                grid.classList.add('has-overflow');
                prevBtn.disabled = grid.scrollLeft <= 4;
                nextBtn.disabled = grid.scrollLeft >= maxScroll - 4;
              }
            }

            if (prevBtn && !prevBtn._hasCategoryListener) {
              prevBtn._hasCategoryListener = true;
              prevBtn.addEventListener('click', function() {
                var scrollAmount = Math.max(grid.clientWidth * 0.6, 200);
                grid.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
              });
            }

            if (nextBtn && !nextBtn._hasCategoryListener) {
              nextBtn._hasCategoryListener = true;
              nextBtn.addEventListener('click', function() {
                var scrollAmount = Math.max(grid.clientWidth * 0.6, 200);
                grid.scrollBy({ left: scrollAmount, behavior: 'smooth' });
              });
            }

            if (!grid._hasCategoryScrollListener) {
              grid._hasCategoryScrollListener = true;
              grid.addEventListener('scroll', updateArrows, { passive: true });
              window.addEventListener('resize', updateArrows);
            }

            setTimeout(updateArrows, 100);
            updateArrows();
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initCategorySliders);
        } else {
          initCategorySliders();
        }
        document.addEventListener('shopify:section:load', initCategorySliders);
      })();
    </script>

    {%- if section.settings.show_view_all -%}
      <div class="shop-by-category__footer text-center">
        {%- assign view_all_target = section.settings.view_all_link -%}
        {%- if view_all_target == blank -%}
          {%- assign view_all_target = routes.collections_url -%}
        {%- endif -%}
        <a href="{{ view_all_target }}" class="shop-by-category__view-all">
          {{ section.settings.view_all_text | escape }} &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop By Category",
  "tag": "section",
  "class": "section-shop-by-category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY CATEGORY"
    },
    {
      "type": "checkbox",
      "id": "show_all_collections",
      "label": "Auto-show all store collections",
      "default": true,
      "info": "When enabled, automatically displays all collections in your store. When disabled, only manually added blocks below will show."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Link Text",
      "default": "VIEW ALL CATEGORIES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link URL"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Label (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Category"
    }
  ]
}
{% endschema %}
