{{ 'section-about-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'about-page.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .about-hero-{{ section.id }} {
    --bg-color: {{ section.settings.background_color | default: '#FAF8F5' }};
    --text-color: {{ section.settings.text_color | default: '#1C1917' }};
    --accent-color: {{ section.settings.accent_color | default: '#824E2B' }};
    background-color: var(--bg-color);
    color: var(--text-color);
  }
{%- endstyle -%}

<section class="about-hero about-hero-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="about-hero__ambient-glow"></div>
  
  <div class="about-container">
    <div class="about-hero__grid {% if section.settings.image_position == 'left' %}about-hero__grid--reverse{% endif %}">
      
      <!-- Content Column -->
      <div class="about-hero__content about-reveal about-reveal--left">
        {%- if section.settings.badge_text != blank -%}
          <div class="about-hero__badge">
            <span class="about-hero__badge-pulse"></span>
            <span class="about-hero__badge-text">{{ section.settings.badge_text | escape }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="about-hero__title">
            {{ section.settings.heading | escape }}
          </h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="about-hero__description">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="about-hero__actions">
            {%- if section.settings.button_1_label != blank -%}
              <a href="{{ section.settings.button_1_url | default: '/collections/all' }}" class="about-btn about-btn--primary">
                <span>{{ section.settings.button_1_label | escape }}</span>
                <svg class="about-btn__arrow" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                </svg>
              </a>
            {%- endif -%}

            {%- if section.settings.button_2_label != blank -%}
              <a href="{{ section.settings.button_2_url | default: '/pages/contact' }}" class="about-btn about-btn--secondary">
                <span>{{ section.settings.button_2_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.settings.show_trust_pills -%}
          <div class="about-hero__trust-strip">
            <div class="trust-item">
              <div class="trust-item__icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
              </div>
              <div>
                <span class="trust-item__title">100% Solid Hardwood</span>
                <span class="trust-item__sub">Seasoned Teak & Oak</span>
              </div>
            </div>

            <div class="trust-item">
              <div class="trust-item__icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                </svg>
              </div>
              <div>
                <span class="trust-item__title">Sustainably Crafted</span>
                <span class="trust-item__sub">FSC Certified Forests</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Image Column (Layered Editorial Collage) -->
      <div class="about-hero__media about-reveal about-reveal--right">
        <div class="about-hero__collage">
          <!-- Main Hero Image -->
          <div class="about-hero__main-frame">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  class: 'about-hero__main-img',
                  alt: section.settings.heading,
                  widths: '600, 900, 1200, 1400'
              }}
            {%- else -%}
              <img
                src="{{ 'about-hero.jpg' | asset_url }}"
                alt="FurniCraft Luxury Showroom"
                class="about-hero__main-img"
                loading="eager"
              />
            {%- endif -%}
            <div class="about-hero__img-overlay"></div>
          </div>

          <!-- Secondary Overlapping Detail Card -->
          <div class="about-hero__detail-frame about-interactive-card">
            <img
              src="{{ 'about-joinery.jpg' | asset_url }}"
              alt="Dovetail Hand-Joinery Detail"
              class="about-hero__detail-img"
              loading="lazy"
            />
            <span class="about-hero__detail-caption">Hand-Cut Dovetail Joints</span>
          </div>

          <!-- Floating Artisan Seal Badge -->
          <div class="about-hero__seal-badge">
            <div class="seal-badge__circle">
              <svg viewBox="0 0 100 100" class="seal-badge__text-path">
                <path id="seal-curve" d="M 50, 50 m -37, 0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" fill="transparent" />
                <text font-size="10.5" font-weight="700" letter-spacing="2" fill="currentColor">
                  <textPath href="#seal-curve" startOffset="0%">
                    • ARTISAN HERITAGE • SINCE 2018 •
                  </textPath>
                </text>
              </svg>
              <div class="seal-badge__center-icon">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Hero Banner",
  "tag": "section",
  "class": "section-about-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "ESTABLISHED WITH PASSION • 2018"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafting Timeless Furniture For Modern Sanctuaries"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>At FurniCraft, we merge traditional artisan woodworking with clean, contemporary architectural aesthetics. Every piece is handcrafted from certified sustainable hardwoods to bring lasting warmth, refinement, and luxury to your everyday living.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary Button Label",
      "default": "EXPLORE COLLECTIONS"
    },
    {
      "type": "url",
      "id": "button_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary Button Label",
      "default": "DESIGN CONSULTATION"
    },
    {
      "type": "url",
      "id": "button_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "checkbox",
      "id": "show_trust_pills",
      "label": "Show Trust Badges Strip",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#FAF8F5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1C1917"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#824E2B"
    }
  ],
  "presets": [
    {
      "name": "About Hero Banner"
    }
  ]
}
{% endschema %}
