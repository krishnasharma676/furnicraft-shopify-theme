{{ 'section-about-process.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .about-process-{{ section.id }} {
    --process-bg: {{ section.settings.background_color | default: '#1C1917' }};
    --process-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --process-accent: {{ section.settings.accent_color | default: '#D4A373' }};
    background-color: var(--process-bg);
    color: var(--process-text);
  }
{%- endstyle -%}

<section class="about-process about-process-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="about-container">
    
    <div class="about-process__header about-reveal">
      {%- if section.settings.badge_text != blank -%}
        <span class="about-process__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-process__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="about-process__subtitle">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>

    <div class="about-process__grid">
      {%- for block in section.blocks -%}
        <div class="process-step about-interactive-card about-reveal" style="transition-delay: {{ forloop.index0 | times: 120 }}ms;" {{ block.shopify_attributes }}>
          <div class="process-step__timeline-bar">
            <span class="process-step__num-badge">{{ forloop.index | prepend: '0' }}</span>
            <div class="process-step__connector-line"></div>
          </div>
          <div class="process-step__card">
            <h3 class="process-step__title">{{ block.settings.title | escape }}</h3>
            <p class="process-step__desc">{{ block.settings.description | escape }}</p>
            {%- if block.settings.tag != blank -%}
              <span class="process-step__tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Creation Process",
  "tag": "section",
  "class": "section-about-process",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "HOW WE CREATE • MASTER JOURNEY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Four-Stage Creation Journey"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From raw sustainably harvested logs to the centerpiece of your living space."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1C1917"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#D4A373"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step Title",
          "default": "Architectural Design"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step Description",
          "default": "Every silhouette starts with hand-sketched blueprints focused on balance, ergonomics, and enduring aesthetic harmony."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Step Badge",
          "default": "Phase 01"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Creation Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Architectural Design",
            "description": "Every silhouette starts with precision hand-sketched blueprints focused on ergonomics, structural balance, and modern proportions.",
            "tag": "Phase 01 • Design & 3D"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Hardwood Selection",
            "description": "We hand-inspect each seasoned plank for moisture content, natural grain flow, and density before it enters our workshop.",
            "tag": "Phase 02 • Kiln-Dried Timber"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Master Hand-Crafting",
            "description": "Artisans cut, plane, and joint each component with traditional mortise-and-tenon craftsmanship and organic oil sanding.",
            "tag": "Phase 03 • Hand-Joined"
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "White Glove Delivery",
            "description": "Each finished piece is custom-crated and delivered directly into your room of choice with hassle-free assembly.",
            "tag": "Phase 04 • Direct To Home"
          }
        }
      ]
    }
  ]
}
{% endschema %}
