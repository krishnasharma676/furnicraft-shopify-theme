

{% liquid
  assign block_settings = block.settings
  assign product = closest.product

  # Read standard Shopify review metafields dynamically from product
  assign rating_meta = product.metafields.reviews.rating.value
  if rating_meta.rating != blank
    assign rating = rating_meta.rating
    assign scale_max = rating_meta.scale_max | default: 5
  elsif product.metafields.reviews.rating.value != blank
    assign rating = product.metafields.reviews.rating.value
    assign scale_max = 5
  elsif product.metafields.reviews.rating != blank
    assign rating = product.metafields.reviews.rating
    assign scale_max = 5
  else
    assign rating = blank
    assign scale_max = 5
  endif

  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count
  assign count_num = rating_count | round
-%}

{%- if rating != blank and count_num > 0 -%}
  {% liquid
    assign star_color = block_settings.star_color | default: '#E5A01A'
    assign star_empty_color = block_settings.star_empty_color | default: '#E5E5E5'

    assign rating_num = rating | plus: 0.0
    assign scale_max_num = scale_max | default: 5 | round
    if scale_max_num <= 0
      assign scale_max_num = 5
    endif

    assign decimal = rating_num | modulo: 1
    assign full_stars = rating_num | floor
    assign has_half_star = false

    if decimal >= 0.25 and decimal <= 0.75
      assign has_half_star = true
    elsif decimal > 0.75
      assign full_stars = full_stars | plus: 1
    endif

    assign half_star_index = full_stars | plus: 1
    assign unique_id = section.id | append: '-' | append: block.id | append: '-' | append: product.id
  %}

  <div
    class="rating-wrapper rating-wrapper-{{ block.id }} justify-{{ block_settings.alignment }} size-style"
    style="{% render 'size-style', settings: block_settings %}; --star-fill-color: {{ star_color }}; --star-empty-color: {{ star_empty_color }};"
    {{ block.shopify_attributes }}
  >
    <svg
      class="visually-hidden"
      style="width: 0; height: 0; position: absolute;"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 32 32"
      role="presentation"
    >
      <defs>
        <linearGradient id="half-{{ unique_id }}" x1="0" x2="100%" y1="0" y2="0">
          <stop offset="50%" stop-color="{{ star_color }}"></stop>
          <stop offset="50%" stop-color="{{ star_empty_color }}"></stop>
        </linearGradient>

        <symbol xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" id="star-icon">
          <path d="M31.547 12a.848.848 0 00-.677-.577l-9.427-1.376-4.224-8.532a.847.847 0 00-1.516 0l-4.218 8.534-9.427 1.355a.847.847 0 00-.467 1.467l6.823 6.664-1.612 9.375a.847.847 0 001.23.893l8.428-4.434 8.432 4.432a.847.847 0 001.229-.894l-1.615-9.373 6.822-6.665a.845.845 0 00.214-.869z" />
        </symbol>
      </defs>
    </svg>

    <div
      class="rating"
      aria-label="Rated {{ rating_num | round: 1 }} out of {{ scale_max_num }} stars based on {{ count_num }} reviews"
      title="{{ rating_num | round: 1 }} out of {{ scale_max_num }} ({{ count_num }} reviews)"
    >
      {%- for star in (1..scale_max_num) -%}
        {%- if star <= full_stars -%}
          <svg class="stars filled-star" viewBox="0 0 32 32" role="presentation">
            <use xlink:href="#star-icon"></use>
          </svg>
        {%- elsif has_half_star and star == half_star_index -%}
          <svg class="stars half-star" viewBox="0 0 32 32" role="presentation">
            <use xlink:href="#star-icon" fill="url(#half-{{ unique_id }})"></use>
          </svg>
        {%- else -%}
          <svg class="stars empty-star" viewBox="0 0 32 32" role="presentation">
            <use xlink:href="#star-icon"></use>
          </svg>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="rating-text-group">
      {%- if block_settings.show_rating_number != false -%}
        <span class="rating-score" aria-hidden="true">{{ rating_num | round: 1 }}</span>
      {%- endif -%}
      {%- if block_settings.show_number != false -%}
        <span class="rating-count" aria-hidden="true">({{ count_num }})</span>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .rating-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: fit-content;
    margin-block: 2px;
    line-height: 1;
    font-size: 0.8125rem;
  }

  .rating-wrapper.justify-center {
    justify-content: center;
  }

  .rating-wrapper.justify-right {
    justify-content: flex-end;
  }

  .rating-wrapper.justify-left {
    justify-content: flex-start;
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  .stars {
    width: 13px;
    height: 13px;
    display: block;
    flex-shrink: 0;
  }

  .filled-star {
    fill: var(--star-fill-color, #E5A01A);
  }

  .empty-star {
    fill: var(--star-empty-color, #E5E5E5);
  }

  .rating-text-group {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    line-height: 1;
  }

  .rating-score {
    font-weight: 600;
    color: #1C1917;
    font-size: 0.8125rem;
  }

  .rating-count {
    font-weight: 400;
    color: #78716C;
    font-size: 0.8125rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_review_stars",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays product star ratings and review counts dynamically from Shopify's standard reviews metafields."
    },
    {
      "type": "checkbox",
      "id": "show_rating_number",
      "label": "Show rating value (e.g. 4.8)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_number",
      "label": "Show review count (e.g. (124))",
      "default": true
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#E5A01A"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty Star Color",
      "default": "#E5E5E5"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:names.product_review_stars",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
